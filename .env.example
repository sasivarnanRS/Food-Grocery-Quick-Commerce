# ==============================================================================
# QUICKCOMMERCE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Infrastructure
NODE_ENV=development
PORT_GATEWAY=4000
PORT_USER_SERVICE=4001
PORT_PRODUCT_SERVICE=4002
PORT_INVENTORY_SERVICE=4003
PORT_CART_SERVICE=4004
PORT_ORDER_SERVICE=4005
PORT_DELIVERY_SERVICE=4006
PORT_NOTIFICATION_SERVICE=4007

# Additional Scaled Product Service Instances (Load Balancing Demo)
PORT_PRODUCT_SERVICE_INSTANCE_2=4012
PORT_PRODUCT_SERVICE_INSTANCE_3=4022

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/quickcommerce

# Redis Configuration (Falls back automatically to In-Memory Engine if not reachable)
REDIS_URL=redis://127.0.0.1:6379

# RabbitMQ Configuration (Falls back automatically to In-Memory Topic Broker if not reachable)
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

# Security & Authentication
JWT_SECRET=quickcommerce_super_secret_jwt_key_2026_production_grade
JWT_EXPIRES_IN=7d

# Frontend Client URL
CLIENT_URL=http://localhost:5173
GATEWAY_URL=http://localhost:4000
